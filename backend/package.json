    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^7.5.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^7.5.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}