generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  PREFER_NOT_TO_SAY
}

enum VolunteerStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CampaignStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum VolunteerTaskStatus {
  ASSIGNED
  CHECKED_IN
  CHECKED_OUT
  COMPLETED
  CANCELLED
}

enum SosRequestStatus {
  OPEN
  RESPONDED
  RESOLVED
  CANCELLED
}

model Volunteer {
  id              Int               @id @default(autoincrement())
  fullName        String            @map("full_name")
  nationalId      String            @unique @map("national_id")
  email           String            @unique
  phone           String            @unique
  passwordHash    String            @map("password_hash")
  gender          Gender?
  dateOfBirth     DateTime?         @map("date_of_birth") @db.Date
  city            String?
  avatarUrl       String?           @map("avatar_url")
  joinDate        DateTime          @default(now()) @map("join_date")
  status          VolunteerStatus   @default(PENDING)
  totalHours      Int               @default(0) @map("total_hours")
  points          Int               @default(0)
  createdAt       DateTime          @default(now()) @map("created_at")
  campaignsCreated Campaign[]       @relation("CampaignCreator")
  assignedTasks   VolunteerTask[]
  reports         Report[]
  sosRequests     SosRequest[]
  ratingsReceived VolunteerRating[] @relation("RatedVolunteer")
  ratingsGiven    VolunteerRating[] @relation("RatingLeader")
  volunteerBadges VolunteerBadge[]
  authSessions    AuthSession[]
  communityPosts  CommunityPost[]
  postComments    CommunityPostComment[]
  postLikes       CommunityPostLike[]

  @@map("volunteers")
}

model AuthSession {
  id               Int       @id @default(autoincrement())
  volunteerId      Int       @map("volunteer_id")
  refreshTokenHash String?   @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent") @db.VarChar(512)
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  volunteer        Volunteer @relation(fields: [volunteerId], references: [id])

  @@index([volunteerId])
  @@map("auth_sessions")
}

model Location {
  id        Int        @id @default(autoincrement())
  name      String
  latitude  Decimal    @db.Decimal(10, 7)
  longitude Decimal    @db.Decimal(10, 7)
  city      String
  area      String
  campaigns Campaign[]
  tasks     Task[]

  @@map("locations")
}

model Campaign {
  id          Int               @id @default(autoincrement())
  title       String
  description String            @db.Text
  coverImage  String?           @map("cover_image")
  startDate   DateTime          @map("start_date")
  endDate     DateTime          @map("end_date")
  locationId  Int               @map("location_id")
  createdById Int               @map("created_by")
  status      CampaignStatus    @default(DRAFT)
  attendanceRadiusMeters Int    @default(100) @map("attendance_radius_meters")
  attendancePoints       Int    @default(50) @map("attendance_points")
  reportPoints           Int    @default(50) @map("report_points")
  location    Location          @relation(fields: [locationId], references: [id])
  createdBy   Volunteer         @relation("CampaignCreator", fields: [createdById], references: [id])
  tasks       Task[]
  reports     Report[]
  ratings     VolunteerRating[]

  @@map("campaigns")
}

model Task {
  id             Int              @id @default(autoincrement())
  title          String
  description    String           @db.Text
  campaignId     Int              @map("campaign_id")
  date           DateTime         @db.Date
  startTime      DateTime?        @map("start_time") @db.Time(0)
  endTime        DateTime?        @map("end_time") @db.Time(0)
  locationId     Int              @map("location_id")
  attendanceRadiusMeters Int?     @map("attendance_radius_meters")
  status         TaskStatus       @default(OPEN)
  campaign       Campaign         @relation(fields: [campaignId], references: [id])
  location       Location         @relation(fields: [locationId], references: [id])
  reports        Report[]
  volunteerTasks VolunteerTask[]

  @@map("tasks")
}

model Report {
  id          Int       @id @default(autoincrement())
  volunteerId Int       @map("volunteer_id")
  taskId      Int       @map("task_id")
  campaignId  Int       @map("campaign_id")
  notes       String?   @db.Text
  voiceNote   String?   @map("voice_note")
  images      Json?
  rating      Int?
  pointsAwarded Int     @default(0) @map("points_awarded")
  createdAt   DateTime  @default(now()) @map("created_at")
  volunteer   Volunteer @relation(fields: [volunteerId], references: [id])
  task        Task      @relation(fields: [taskId], references: [id])
  campaign    Campaign  @relation(fields: [campaignId], references: [id])

  @@unique([volunteerId, taskId])
  @@map("reports")
}

model VolunteerTask {
  id           Int                 @id @default(autoincrement())
  volunteerId  Int                 @map("volunteer_id")
  taskId       Int                 @map("task_id")
  status       VolunteerTaskStatus @default(ASSIGNED)
  checkInTime  DateTime?           @map("check_in_time")
  checkInLatitude Decimal?         @map("check_in_latitude") @db.Decimal(10, 7)
  checkInLongitude Decimal?        @map("check_in_longitude") @db.Decimal(10, 7)
  checkOutTime DateTime?           @map("check_out_time")
  checkOutLatitude Decimal?        @map("check_out_latitude") @db.Decimal(10, 7)
  checkOutLongitude Decimal?       @map("check_out_longitude") @db.Decimal(10, 7)
  hoursWorked  Int                 @default(0) @map("hours_worked")
  attendancePointsAwarded Int      @default(0) @map("attendance_points_awarded")
  volunteer    Volunteer           @relation(fields: [volunteerId], references: [id])
  task         Task                @relation(fields: [taskId], references: [id])

  @@unique([volunteerId, taskId])
  @@map("volunteer_tasks")
}

model VolunteerRating {
  id          Int        @id @default(autoincrement())
  volunteerId Int        @map("volunteer_id")
  leaderId    Int?       @map("leader_id")
  campaignId  Int?       @map("campaign_id")
  rating      Int
  feedback    String?    @db.Text
  createdAt   DateTime   @default(now()) @map("created_at")
  volunteer   Volunteer  @relation("RatedVolunteer", fields: [volunteerId], references: [id])
  leader      Volunteer? @relation("RatingLeader", fields: [leaderId], references: [id])
  campaign    Campaign?  @relation(fields: [campaignId], references: [id])

  @@map("volunteer_ratings")
}

model SosRequest {
  id          Int              @id @default(autoincrement())
  volunteerId Int              @map("volunteer_id")
  latitude    Decimal          @db.Decimal(10, 7)
  longitude   Decimal          @db.Decimal(10, 7)
  status      SosRequestStatus @default(OPEN)
  createdAt   DateTime         @default(now()) @map("created_at")
  resolvedAt  DateTime?        @map("resolved_at")
  volunteer   Volunteer        @relation(fields: [volunteerId], references: [id])

  @@map("sos_requests")
}

model Badge {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  description     String           @db.Text
  pointsRequired  Int              @map("points_required")
  volunteerBadges VolunteerBadge[]

  @@map("badges")
}

model VolunteerBadge {
  id          Int       @id @default(autoincrement())
  volunteerId Int       @map("volunteer_id")
  badgeId     Int       @map("badge_id")
  awardedAt   DateTime  @default(now()) @map("awarded_at")
  volunteer   Volunteer @relation(fields: [volunteerId], references: [id])
  badge       Badge     @relation(fields: [badgeId], references: [id])

  @@unique([volunteerId, badgeId])
  @@map("volunteer_badges")
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String
  content   String   @db.Text
  image     String?
  isPinned  Boolean  @default(false) @map("is_pinned")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("announcements")
}

model CommunityPost {
  id         Int                    @id @default(autoincrement())
  volunteerId Int                   @map("volunteer_id")
  content    String                 @db.Text
  image      String?
  createdAt  DateTime               @default(now()) @map("created_at")
  updatedAt  DateTime               @updatedAt @map("updated_at")
  volunteer  Volunteer              @relation(fields: [volunteerId], references: [id])
  comments   CommunityPostComment[]
  likes      CommunityPostLike[]

  @@index([volunteerId])
  @@map("community_posts")
}

model CommunityPostComment {
  id         Int           @id @default(autoincrement())
  postId     Int           @map("post_id")
  volunteerId Int          @map("volunteer_id")
  content    String        @db.Text
  createdAt  DateTime      @default(now()) @map("created_at")
  post       CommunityPost @relation(fields: [postId], references: [id])
  volunteer  Volunteer     @relation(fields: [volunteerId], references: [id])

  @@index([postId])
  @@index([volunteerId])
  @@map("community_post_comments")
}

model CommunityPostLike {
  id         Int           @id @default(autoincrement())
  postId     Int           @map("post_id")
  volunteerId Int          @map("volunteer_id")
  createdAt  DateTime      @default(now()) @map("created_at")
  post       CommunityPost @relation(fields: [postId], references: [id])
  volunteer  Volunteer     @relation(fields: [volunteerId], references: [id])

  @@unique([postId, volunteerId])
  @@index([volunteerId])
  @@map("community_post_likes")
}
